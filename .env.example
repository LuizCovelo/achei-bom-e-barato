# Configure estes valores em Vercel > Project Settings > Environment Variables.
# Nunca coloque credenciais reais neste arquivo nem as envie ao GitHub.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Opcional: nomes amigáveis para IDs de categoria retornados pela API.
# Exemplo: {"123":"Casa e Cozinha","456":"Beleza"}
SHOPEE_CATEGORY_MAP={}
